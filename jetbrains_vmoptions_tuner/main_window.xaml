<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1440" Margin="40,32,40,44" Spacing="26">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="14" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Image x:Name="AppIcon" Width="56" Height="56"/>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="vmoptions Tuner" FontSize="32" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.62"
                                               VerticalAlignment="Center"/>
                                    <HyperlinkButton x:Name="RepositoryLink" Padding="4"
                                                     NavigateUri="https://github.com/DragonSavA/JBvmotionsTuner"
                                                     AutomationProperties.Name="GitHub">
                                        <ToolTipService.ToolTip>
                                            <ToolTip x:Name="RepositoryToolTip" Content="Open the project on GitHub"/>
                                        </ToolTipService.ToolTip>
                                        <Image x:Name="GitHubIcon" Width="24" Height="24"/>
                                    </HyperlinkButton>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="TaglineText" Text="Your JetBrains IDE settings stay in place after every update."
                                   FontSize="16" Opacity="0.72" TextWrapping="Wrap"/>
                        <Button x:Name="SyncAllTop" Content="Synchronize all"
                                Padding="18,9" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20,16">
                        <StackPanel Spacing="14">
                            <TextBlock x:Name="SettingsTitle" Text="Settings" FontSize="20" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="LanguageLabel" Text="Language" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ToggleButton x:Name="EnglishLanguageButton" Content="ENG" IsChecked="True"/>
                                <TextBlock Text="|" VerticalAlignment="Center" Opacity="0.6"/>
                                <ToggleButton x:Name="RussianLanguageButton" Content="RUS"/>
                            </StackPanel>
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="320"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="AppearanceLabel" Text="Appearance" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <ComboBox x:Name="ThemePicker" Header="Theme" Width="145">
                                            <ComboBoxItem x:Name="SystemThemeItem" Content="System default"/>
                                            <ComboBoxItem x:Name="LightThemeItem" Content="Light"/>
                                            <ComboBoxItem x:Name="DarkThemeItem" Content="Dark"/>
                                        </ComboBox>
                                        <TextBox x:Name="AccentBox" Header="Accent" Width="120"
                                                 PlaceholderText="#00FF00"/>
                                        <Button x:Name="ApplyAppearanceButton" Content="Apply"
                                                VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1,0,0,0" Padding="20,0,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="AutostartLabel" Text="Autostart" FontWeight="SemiBold"/>
                                        <ToggleSwitch x:Name="AutostartToggle" OnContent="Enabled"
                                                      OffContent="Disabled"/>
                                        <TextBlock x:Name="AutostartHint" Opacity="0.7"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="DesktopShortcutLabel" Text="Desktop icon" FontWeight="SemiBold"
                                                   Margin="0,8,0,0"/>
                                        <ToggleSwitch x:Name="DesktopShortcutToggle" OnContent="Enabled"
                                                      OffContent="Disabled"/>
                                        <TextBlock x:Name="DesktopShortcutHint" Opacity="0.7"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <InfoBar x:Name="StatusInfo" IsOpen="False" IsClosable="True"/>

                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="22">
                    <StackPanel Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock x:Name="IdesTitle" Text="IDEs and files" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock x:Name="IdesDescription" Text="Select a product and choose its .vmoptions file manually."
                                           Opacity="0.7"/>
                            </StackPanel>
                            <Button x:Name="NewIdeButton" Grid.Column="1" Content="New association"/>
                        </Grid>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ListView x:Name="IdeList" Height="260" SelectionMode="Single"/>
                            <StackPanel Grid.Column="1" Spacing="12">
                                <ComboBox x:Name="ProductPicker" Header="IDE" MinWidth="320"
                                          HorizontalAlignment="Stretch"/>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="IdePathBox" Header=".vmoptions file"
                                             PlaceholderText="D:\Apps\JetBrains\...\product64.exe.vmoptions"/>
                                    <Button x:Name="ChooseFileButton" Grid.Column="1" Content="Choose file…"
                                            VerticalAlignment="Bottom"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="SaveIdeButton" Content="Save association"/>
                                    <Button x:Name="DeleteIdeButton" Content="Delete"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="22">
                    <StackPanel Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock x:Name="GroupsTitle" Text="Option sets" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GroupsDescription" Text="One set can be assigned to multiple IDEs; each IDE can have only one set."
                                           Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="NewGroupButton" Grid.Column="1" Content="New set"/>
                        </Grid>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ListView x:Name="GroupList" Height="360" SelectionMode="Single"/>
                            <StackPanel Grid.Column="1" Spacing="12">
                                <TextBox x:Name="GroupNameBox" Header="Set name"
                                         PlaceholderText="Example: Common JVM options"/>
                                <TextBlock x:Name="AssignIdesLabel" Text="Assign to IDEs" FontWeight="SemiBold"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Padding="2,2,2,4">
                                    <StackPanel x:Name="GroupIdeButtons" Orientation="Horizontal" Spacing="8"/>
                                </ScrollViewer>
                                <TextBox x:Name="GroupLinesBox" Header="Options — one per line"
                                         AcceptsReturn="True" TextWrapping="NoWrap" Height="160"
                                         FontFamily="Consolas"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         PlaceholderText="-Xmx4096m&#x0a;-Dexample=true"/>
                                <TextBlock x:Name="GroupValidationText" Foreground="#E5484D"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="AddCompatibilityButton"
                                            Content="Add plugin compatibility override"/>
                                    <Button x:Name="SaveGroupButton" Content="Save set"/>
                                    <Button x:Name="DeleteGroupButton" Content="Delete"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="22">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="EditorTitle" Text="View and edit .vmoptions" FontSize="22"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="EditorDescription" Text="Lines from the assigned set are highlighted in green."
                                       Opacity="0.7"/>
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Padding="2,2,2,4">
                            <StackPanel x:Name="ViewerIdeButtons" Orientation="Horizontal" Spacing="8"/>
                        </ScrollViewer>
                        <TextBlock x:Name="ViewerPathText" FontFamily="Consolas" Opacity="0.72"
                                   TextWrapping="Wrap"/>
                        <Border x:Name="MissingPanel" Background="#2633A852" CornerRadius="8"
                                Padding="12" Visibility="Collapsed">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MissingText" VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <Button x:Name="SyncSelectedButton" Grid.Column="1"
                                        Content="Synchronize now"/>
                            </Grid>
                        </Border>
                        <Border x:Name="SavePanel" Background="#264F7CFF" CornerRadius="8"
                                Padding="12" Visibility="Collapsed">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="UnsavedPrompt" Text="The contents have changed. Save the file?"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="DiscardFileButton" Content="Discard changes"/>
                                    <Button x:Name="SaveFileButton" Content="Save file"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <RichEditBox x:Name="OptionsEditor" Height="430" AcceptsReturn="True"
                                     IsSpellCheckEnabled="False" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="14"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock x:Name="LastManualText" Opacity="0.72"/>
                        <TextBlock x:Name="LastAutoText" Opacity="0.72"/>
                    </StackPanel>
                    <Button x:Name="SyncAllBottom" Grid.Column="1" Content="Synchronize all"
                            Padding="18,9" VerticalAlignment="Center"/>
                </Grid>
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" Padding="0,18,0,0">
                    <TextBlock x:Name="TrademarkNotice" Text="All trademarks and logos belong to their respective owners. The project author is not affiliated with or a representative of these owners."
                               Opacity="0.62" FontSize="12" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>
                <StackPanel x:Name="DevelopmentCredit" Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Image x:Name="AuthorIcon" Width="76" Height="76"/>
                    <TextBlock x:Name="DevelopedByText" Text="Developed by" FontSize="28"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <HyperlinkButton x:Name="AuthorLink" Content="DragonSavA" FontSize="28"
                                     FontWeight="SemiBold" Padding="0" VerticalAlignment="Center"
                                     NavigateUri="https://github.com/DragonSavA?tab=overview"/>
                    <TextBlock x:Name="WithCodexText" Text="with Codex" FontSize="28"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Image x:Name="CodexIcon" Width="64" Height="64"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
