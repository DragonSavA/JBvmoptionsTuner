<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1440" Margin="40,32,40,44" Spacing="26">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="vmoptions Tuner" FontSize="32" FontWeight="SemiBold"/>
                        <TextBlock Text="Ваши настройки JetBrains IDE — на месте после каждого обновления."
                                   FontSize="16" Opacity="0.72" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                VerticalAlignment="Center">
                        <ComboBox x:Name="ThemePicker" Header="Тема" Width="150">
                            <ComboBoxItem Content="Как в системе"/>
                            <ComboBoxItem Content="Светлая"/>
                            <ComboBoxItem Content="Тёмная"/>
                        </ComboBox>
                        <TextBox x:Name="AccentBox" Header="Акцент" Width="125" PlaceholderText="#00FF00"/>
                        <Button x:Name="ApplyAppearanceButton" Content="Применить"
                                VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ToggleSwitch x:Name="AutostartToggle" Header="Автозапуск" OnContent="Включён"
                                  OffContent="Выключен" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AutostartHint" Grid.Column="1" VerticalAlignment="Center"
                               Opacity="0.7" TextWrapping="Wrap"/>
                    <Button x:Name="SyncAllTop" Grid.Column="2" Content="Синхронизировать все"
                            Padding="18,9"/>
                </Grid>

                <InfoBar x:Name="StatusInfo" IsOpen="False" IsClosable="True"/>

                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="22">
                    <StackPanel Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="IDE и файлы" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="Выберите продукт и укажите его .vmoptions вручную."
                                           Opacity="0.7"/>
                            </StackPanel>
                            <Button x:Name="NewIdeButton" Grid.Column="1" Content="Новая связка"/>
                        </Grid>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ListView x:Name="IdeList" Height="260" SelectionMode="Single"/>
                            <StackPanel Grid.Column="1" Spacing="12">
                                <ComboBox x:Name="ProductPicker" Header="IDE" MinWidth="320"
                                          HorizontalAlignment="Stretch"/>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="IdePathBox" Header="Файл .vmoptions"
                                             PlaceholderText="D:\Apps\JetBrains\...\product64.exe.vmoptions"/>
                                    <Button x:Name="ChooseFileButton" Grid.Column="1" Content="Выбрать файл…"
                                            VerticalAlignment="Bottom"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="SaveIdeButton" Content="Сохранить связку"/>
                                    <Button x:Name="DeleteIdeButton" Content="Удалить"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="22">
                    <StackPanel Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Наборы строк" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="Один набор можно назначить нескольким IDE; у каждой IDE может быть только один набор."
                                           Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="NewGroupButton" Grid.Column="1" Content="Новый набор"/>
                        </Grid>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ListView x:Name="GroupList" Height="360" SelectionMode="Single"/>
                            <StackPanel Grid.Column="1" Spacing="12">
                                <TextBox x:Name="GroupNameBox" Header="Название набора"
                                         PlaceholderText="Например: Общие параметры JVM"/>
                                <TextBlock Text="Назначить IDE" FontWeight="SemiBold"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="GroupIdeButtons" Orientation="Horizontal" Spacing="8"/>
                                </ScrollViewer>
                                <TextBox x:Name="GroupLinesBox" Header="Строки — по одной на строке"
                                         AcceptsReturn="True" TextWrapping="NoWrap" Height="160"
                                         FontFamily="Consolas"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         PlaceholderText="-Xmx4096m&#x0a;-Dexample=true"/>
                                <TextBlock x:Name="GroupValidationText" Foreground="#E5484D"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="AddCompatibilityButton"
                                            Content="Добавить игнорирование совместимости плагинов"/>
                                    <Button x:Name="SaveGroupButton" Content="Сохранить набор"/>
                                    <Button x:Name="DeleteGroupButton" Content="Удалить"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="22">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Просмотр и редактирование .vmoptions" FontSize="22"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Строки назначенного набора подсвечиваются зелёным."
                                       Opacity="0.7"/>
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ViewerIdeButtons" Orientation="Horizontal" Spacing="8"/>
                        </ScrollViewer>
                        <TextBlock x:Name="ViewerPathText" FontFamily="Consolas" Opacity="0.72"
                                   TextWrapping="Wrap"/>
                        <Border x:Name="MissingPanel" Background="#2633A852" CornerRadius="8"
                                Padding="12" Visibility="Collapsed">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MissingText" VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <Button x:Name="SyncSelectedButton" Grid.Column="1"
                                        Content="Синхронизировать сейчас"/>
                            </Grid>
                        </Border>
                        <Border x:Name="SavePanel" Background="#264F7CFF" CornerRadius="8"
                                Padding="12" Visibility="Collapsed">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Содержимое изменено. Сохранить файл?"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="DiscardFileButton" Content="Отменить изменения"/>
                                    <Button x:Name="SaveFileButton" Content="Сохранить файл"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <RichEditBox x:Name="OptionsEditor" Height="430" AcceptsReturn="True"
                                     IsSpellCheckEnabled="False" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="14"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock x:Name="LastManualText" Opacity="0.72"/>
                        <TextBlock x:Name="LastAutoText" Opacity="0.72"/>
                    </StackPanel>
                    <Button x:Name="SyncAllBottom" Grid.Column="1" Content="Синхронизировать все"
                            Padding="18,9" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
